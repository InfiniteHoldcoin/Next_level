# =====================================================
# NextLevel — Environment variables
# Copy to .env and fill in values
# Production secrets managed via Doppler
# =====================================================

# --- App ---
NODE_ENV=development
APP_NAME=nextlevel
LOG_LEVEL=info

# --- Supabase (région ca-central-1) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgres://postgres:password@host:5432/postgres
SUPABASE_PROJECT_REF=
SUPABASE_JWT_SECRET=

# --- Dashboard (Next.js public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- API ---
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3001

# --- Auth ---
AUTH_JWT_SECRET=
AUTH_COOKIE_DOMAIN=localhost

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
LLM_DEFAULT_MAX_TOKENS=2048
LLM_PROMPT_CACHE_ENABLED=true

# --- Embeddings ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV_SERVER_URL=http://localhost:8288

# --- Langfuse (self-hosted) ---
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- PostHog ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Stripe (Phase 9+) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Twilio (Stage 2) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- ElevenLabs (Stage 2) ---
ELEVENLABS_API_KEY=

# --- Shopify (per-tenant OAuth, base config here) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_customers,read_orders,write_themes,read_content,write_content
SHOPIFY_APP_URL=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Slack (Phase 5) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- URLs ---
API_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# --- Redis (Upstash) ---
REDIS_URL=
REDIS_TOKEN=

# --- Cost cap defaults ---
DEFAULT_TENANT_MONTHLY_COST_CAP_USD=50
COST_CAP_HARD_KILL=true

# --- i18n ---
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,en
